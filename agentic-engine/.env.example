# Agentic Quantum Learning Engine Environment Configuration
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development

# LLM Configuration: Gemini (primary) -> Groq (free fallback) -> Mock (offline safety net)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq free-tier fallback - used automatically when Gemini's quota/rate limit is hit.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# External Information Retrieval (Tavily Search)
TAVILY_API_KEY=

# Execution Sandbox Configuration
MAX_DEBUG_ITERATIONS=5
EXECUTION_TIMEOUT_SECONDS=15
LOCAL_SIMULATION_ONLY=true
ENABLE_MCP_TOOLS=true

# Database (PostgreSQL / Neon DB) - shared with server/ and ai-engine/
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5001"]
